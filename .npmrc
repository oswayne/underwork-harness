# Private package registry: hosts the UICP eureka family and proxies the public
# npm registry for everything else.
registry=https://verdaccio.underwork.cn/

# The @openai scope (the @openai/codex CLI used by the upstream subagent-codex
# provider) is fetched from the public npm registry: the private proxy cannot
# serve it. The fork disables the provider at runtime, so this dependency is
# install-time only.
@openai:registry=https://registry.npmjs.org/
