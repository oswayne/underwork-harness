{
  "identifier": "default",
  "windows": ["main", "uicp-editor"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-open-editor-window",
    "allow-get-token",
    "allow-set-token",
    "allow-clear-token",
    "allow-app-packages-root"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
