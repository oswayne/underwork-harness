    "@deepseek-ai/dsh-sandbox-server": "workspace:^",
    "@deepseek-ai/dsh-tool-apppackage-publish": "workspace:^",
    "@deepseek-ai/dsh-tool-apppackage-test": "workspace:^",
    "@deepseek-ai/dsh-tool-apppackage-validate": "workspace:^"
  }
