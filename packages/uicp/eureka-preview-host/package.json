{
  "name": "@deepseek-ai/dsh-eureka-preview-host",
  "description": "Self-contained Eureka page preview bundle (React 19) for the UICP low-code driver",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/uicp/eureka-preview-host"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "dist/**"
  ],
  "license": "MIT",
  "scripts": {
    "build:preview": "vite build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "eureka": "^8.14.6",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "eureka-core": "^8.14.6",
    "eureka-editor": "^8.14.6",
    "eureka-editor-core": "^8.14.6",
    "eureka-formula": "^8.14.6",
    "eureka-ui": "^8.14.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^7.0.0"
  }
}
