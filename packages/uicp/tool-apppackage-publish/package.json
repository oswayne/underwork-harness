{
  "name": "@deepseek-ai/dsh-tool-apppackage-publish",
  "description": "Model-facing API save for UICP app packages: idempotent upsert after user adoption",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/uicp/tool-apppackage-publish"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
